/runtime/

# env
.env
.env.*.local

# The screenshot pipeline's scratch daemon: a state dir with its own keychain-backed secrets file,
# a database full of an invented evening, and the composited HTML built from them. Regenerated by
# `bun run docs stage` and `docs pages` — see tools/src/docs.ts.
.docs-state/
build/
# A scratch state dir used by hand while smoke-testing. Same reasoning as above.
.tmp-graphs-state/

# caches
.cache
.eslintcache

# editors / OS
.idea
.vscode/*
!.vscode/extensions.json
.DS_Store

# The publishable build of @vrcz/plugin-api. Produced by `bun run build:plugin-api`, published with
# `npm publish packages/plugin-api/dist`, and never committed — it is derived from src/.
packages/plugin-api/dist/
