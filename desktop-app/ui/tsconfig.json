{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The UI is a browser bundle, not a Bun program: it gets DOM libs and Vite's ambient
    // types instead of `@types/bun`, and it is deliberately excluded from the root
    // `tsc --noEmit` (see ../tsconfig.json). `bun run check` (svelte-check) is the type gate.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "svelte.config.js"],
  "exclude": ["node_modules", "dist"]
}
