{
  "name": "vrc.zip",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "workspaces": [
    "packages/*",
    "daemon",
    "ui",
    "tools"
  ],
  "scripts": {
    "daemon": "bun --watch daemon/src/index.ts",
    "notify:smoke": "bun daemon/src/os/toast-smoke.ts",
    "codegen": "bun run --filter @vrcz/tools codegen",
    "icon": "bun run --filter @vrcz/tools icon",
    "package": "bun run --filter @vrcz/tools package",
    "test": "bun test packages daemon tools",
    "test:ui": "bun run --filter @vrcz/ui test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "codegen:plugin-docs": "bun tools/src/plugin-docs.ts",
    "build:plugin-api": "bun tools/src/publish-plugin-api.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  }
}