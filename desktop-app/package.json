{
  "name": "vrc.zip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "workspaces": [
    "packages/*",
    "daemon",
    "ui",
    "tools"
  ],
  "scripts": {
    "daemon": "bun --watch daemon/src/index.ts",
    "codegen": "bun run --filter @vrcz/tools codegen",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  }
}
